# DeepSeek API (LLM - chat/completion)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API (embeddings only - for vector store / add_embeddings.py)
OPENAI_API_KEY=your_openai_api_key_here

# Neo4j Database Configuration
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Telegram chat history in Neo4j (follow-up context in synthesis)
# CHAT_HISTORY_ENABLED=true
# CHAT_HISTORY_LIMIT=10

# Optional: Graphiti semantic memory (same Neo4j; needs OPENAI_API_KEY for extraction/embeddings)
# GRAPHITI_MEMORY_ENABLED=true
# GRAPHITI_SEARCH_LIMIT=8
# GRAPHITI_NEO4J_DATABASE=neo4j

# Optional: GraphRAG retrieval tuning (see README — Retrieval quality)
# HYBRID_VECTOR_K=8
# FALLBACK_CHUNK_LIMIT=8
# FALLBACK_MERGE_CAP=12
# CHUNK_FULLTEXT_INDEX=chunk_text_index
